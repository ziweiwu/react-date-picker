{
  "name": "react-hig-datepicker",
  "version": "1.3.1",
  "description": "An accessible date picker React component styled with the Autodesk HIG design language",
  "keywords": [
    "react",
    "react-component",
    "datepicker",
    "date-picker",
    "calendar",
    "hig",
    "accessibility"
  ],
  "author": "Ziwei Wu",
  "license": "MIT",
  "homepage": "https://ziweiwu.github.io/react-date-picker/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziweiwu/react-date-picker.git"
  },
  "bugs": {
    "url": "https://github.com/ziweiwu/react-date-picker/issues"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "main": "lib/index.js",
  "module": "es/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./es/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./styles.css": "./css/datePicker.css",
    "./css/datePicker.css": "./css/datePicker.css",
    "./lib/datePicker.css": "./css/datePicker.css",
    "./es/datePicker.css": "./css/datePicker.css",
    "./package.json": "./package.json"
  },
  "files": [
    "css",
    "es",
    "lib",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.stories.*",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node -e \"for (const d of ['lib','es','css','demo/dist']) require('node:fs').rmSync(d,{recursive:true,force:true})\"",
    "start": "vite --config vite.demo.config.mts",
    "demo:build": "vite build --config vite.demo.config.mts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "audit": "npm audit --omit=dev",
    "prepublishOnly": "npm run lint && npm run test && npm run build && npm run check:package",
    "test:e2e": "playwright test",
    "check:package": "node scripts/check-package.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "demo:gif": "node scripts/demo-gif.mjs",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.15",
    "clsx": "^2.1.1",
    "react-datepicker": "^9.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.13.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.83.0",
    "storybook": "^10.5.8",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,json,yml,yaml,html}": [
      "prettier --write"
    ]
  }
}
